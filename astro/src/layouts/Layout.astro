---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';

const { title = 'Damian Romeijn' } = Astro.props;
const lang = Astro.currentLocale || 'nl';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Font cssVariable="--font-unbounded" preload />
    <Font cssVariable="--font-hypsan" preload />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>