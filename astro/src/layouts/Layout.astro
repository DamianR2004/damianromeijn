---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Ascii from '../components/Ascii.astro';

interface Props {
  title?: string;
  modelPath: string;
  scaleFactor?: number;
  offsetY?: number;
}

const { 
  title = 'Damian Romeijn', 
  modelPath, 
  scaleFactor = 2.0,
  offsetY = 0
} = Astro.props;

const lang = Astro.currentLocale || 'nl';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Font cssVariable="--font-unbounded" preload />
    <Font cssVariable="--font-hypsan" preload />
    <title>{title}</title>
  </head>
  <body>
    <!-- De 3D achtergrond -->
    <Ascii modelPath={modelPath} scaleFactor={scaleFactor} offsetY={offsetY}/>
    
    <!-- De content die de gebruiker ziet -->
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>